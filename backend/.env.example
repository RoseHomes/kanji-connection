# Copy to backend/.env; configure locally. Never paste real secrets into chat.
# Database mode never silently falls back to sample data on missing credentials/errors.
CONTENT_SOURCE=database
DATABASE_URL="postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres"
# Separate direct/session connection; configuring it does not authorize or run migrations.
MIGRATION_DATABASE_URL="postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres"
DATABASE_SSLMODE=require
# For verified TLS use verify-full plus the downloaded Supabase CA certificate path.
# DATABASE_SSLROOTCERT=C:/path/to/supabase-ca.crt
DATABASE_CONNECT_TIMEOUT=10
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_POOL_TIMEOUT=5
# False excludes all sample rows from public database APIs.
EXPOSE_SAMPLES=false
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Optional public publishable/anon key for legacy HS256 verification through Auth /user.
# Never use a JWT signing secret or service-role/secret API key.
# SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
# Keep false until owner authorization for account writes to this configured database.
ENABLE_USER_WRITES=false
# Local development only: exact authenticated user UUIDs allowed to see private content.
DEVELOPMENT_USER_IDS=[]
