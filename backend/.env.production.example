# Vercel BACKEND project only; configure through its environment-variable UI.
# This template deliberately contains no credentials and cannot be used unchanged.
# VERCEL=1 is supplied automatically by Vercel; do not copy local development variables.
CONTENT_SOURCE=database
DATABASE_URL="postgresql+psycopg://postgres.YOUR_PROJECT_REF:URL_ENCODED_PASSWORD@EXACT_POOLER_HOST_FROM_SUPABASE:6543/postgres"
DATABASE_SSLMODE=require
# Optional verified TLS after checking the certificate/CA in the hosted runtime:
# DATABASE_SSLMODE=verify-full
# DATABASE_SSLROOTCERT=system
DATABASE_CONNECT_TIMEOUT=10
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_POOL_TIMEOUT=5
EXPOSE_SAMPLES=false
CORS_ORIGINS=["https://YOUR_FRONTEND_PROJECT.vercel.app"]
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Only needed for legacy shared-secret JWT verification, and still a PUBLIC key:
# SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLIC_PUBLISHABLE_KEY
ENABLE_USER_WRITES=false
DEVELOPMENT_USER_IDS=[]
# Do not set MIGRATION_DATABASE_URL, TEST_DATABASE_URL or any admin/service-role key.
