# Build/runtime inputs for the separate frontend and backend projects.
# Explicit project- and repository-relative paths; protected inputs stay excluded.
/*
!/.vercelignore
!/vercel.json
!/package.json
!/package-lock.json
!/index.html
!/tsconfig.json
!/vite.config.ts
!/src/
!/public/
/public/*
!/public/assets/
/public/assets/*
!/public/assets/japanese-audio-index.json
!/frontend/
/frontend/*
!/frontend/.vercelignore
!/frontend/vercel.json
!/frontend/package.json
!/frontend/package-lock.json
!/frontend/index.html
!/frontend/tsconfig.json
!/frontend/vite.config.ts
!/frontend/src/
!/frontend/public/
/frontend/public/*
!/frontend/public/assets/
/frontend/public/assets/*
!/frontend/public/assets/japanese-audio-index.json
!/index.py
!/.python-version
!/pyproject.toml
!/requirements.txt
!/app/
!/backend/
/backend/*
!/backend/.vercelignore
!/backend/vercel.json
!/backend/index.py
!/backend/.python-version
!/backend/pyproject.toml
!/backend/requirements.txt
!/backend/app/
**/app/book*.py
**/app/content_schema.py
**/app/editorial.py
**/app/json_content.py
**/app/thai_references.py
**/app/seed*.py
**/app/**/*.json
**/__pycache__/
**/*.pyc
**/.env*
**/private/
**/reference/
**/artifacts/
**/node_modules/
**/*.[pP][dD][fF]
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.crt
**/*.cer
**/*.der
**/*.jks
**/*.p8
**/*.keystore
**/*.dpapi
**/*.db
**/*.sqlite
**/*.sqlite3
**/credentials.json
**/*.test.ts
**/*.test.tsx
**/src/test-setup.ts
**/src/**/*.json
