# Vercel FRONTEND project only. Set in its Production/Preview Environment Variables.
# All VITE_ values are public and become part of the browser bundle.
# Exact backend HTTPS origin; no trailing /api or /api/v1.
VITE_API_URL=https://YOUR_BACKEND_PROJECT.vercel.app
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLIC_PUBLISHABLE_KEY
# Never place DATABASE_URL, passwords, service-role/secret keys or allowlists here.
